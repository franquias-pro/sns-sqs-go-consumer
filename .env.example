AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/example-events
POLLERS=16
WORKERS=200
ACKERS=8
PROCESS_TIMEOUT=15s
VISIBILITY_TIMEOUT=120
SHUTDOWN_TIMEOUT=45s
LOG_LEVEL=info
ELASTIC_APM_SERVICE_NAME=sns-sqs-go-consumer
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SECRET_TOKEN=
ELASTIC_APM_TRANSACTION_SAMPLE_RATE=0.01
ELASTIC_APM_METRICS_INTERVAL=30s
